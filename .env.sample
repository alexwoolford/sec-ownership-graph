# =============================================================================
# SEC Ownership Graph — environment configuration
# =============================================================================
# Copy to .env and fill in. .env is gitignored; never commit it.
#   cp .env.sample .env
# =============================================================================

# -----------------------------------------------------------------------------
# Neo4j (REQUIRED)
# -----------------------------------------------------------------------------
# neo4j:// for local, neo4j+s:// for Aura.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# The ownership graph lives in its own database. Creating a named database requires Neo4j
# Enterprise (or Aura); on Community, use the default `neo4j` database instead.
NEO4J_DATABASE=secgraph

# -----------------------------------------------------------------------------
# SEC EDGAR (REQUIRED to build)
# -----------------------------------------------------------------------------
# SEC fair access requires a User-Agent that identifies you with real contact info. The built-in
# default is a placeholder on the RFC-2606 reserved domain example.com, which SEC rejects with
# HTTP 403 — and a 403 on every request means an empty graph. The preflight refuses to start a
# build until this is set to something real.
SEC_USER_AGENT=Your Name your.email@domain.com

# Concurrent workers for the 13D/13G crawl (default 10). The shared rate limiter caps actual
# throughput at SEC's 10 req/s regardless, so raising this cannot breach fair access.
# OWNERSHIP_CRAWL_WORKERS=10

# -----------------------------------------------------------------------------
# OpenAI (OPTIONAL — only for one build step)
# -----------------------------------------------------------------------------
# Needed ONLY by scripts/extract_control_edges.py, which reads percent-of-class and
# control-vs-stake figures out of Schedule 13D cover-page prose. Every traversal and every
# served answer is deterministic Cypher with no model in the loop, so querying an
# already-built graph needs no API key at all.
#
# Two ways to satisfy the control-extraction phase; the preflight accepts either:
#   1. reference/control_figures.csv is committed  -> no key, no openai package needed
#   2. otherwise                                   -> pip install -e ".[dev,llm]" + a key below
# Note the plain "[dev]" extra deliberately omits openai.
# OPENAI_API_KEY=sk-proj-your_openai_key_here

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - All ownership data comes directly from SEC EDGAR (bulk Form 3/4/5 and 13F datasets, plus
#   per-issuer 13D/G crawling). No paid data vendor is required.
# - Staged bulk datasets land in data/ and are gitignored; re-fetch with
#   scripts/download_ownership_data.py.
