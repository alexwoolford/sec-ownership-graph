# Secrets — never commit. Copy .env.sample to .env and fill it in locally.
.env
.env.*
!.env.sample

# Local AI-agent config and session state (machine-specific, may contain local paths).
.claude/
# Ignore .cursor contents, but ship the portable project MCP config.
.cursor/*
!.cursor/mcp.json
.aider*

# Working scratch space for reference material — papers, vendor docs, market research — that
# informs the work but is not part of it. Third-party content and licensing make it unsafe to
# publish from a repo this open, so it stays local by construction.
context/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Staged SEC bulk datasets (large; re-downloadable via download_ownership_data.py)
data/
logs/

# Generated run output. The two committed memos under results/ are regenerable via
# prove_graph_native_wins.py / activist_convergence.py; everything else is disposable.
results/*.json
!results/secgraph_freshness.json

# Editors / OS
.vscode/
.idea/
.DS_Store
