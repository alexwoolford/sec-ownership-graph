# Secrets — never commit. Copy .env.sample to .env and fill it in locally.
.env
.env.*
!.env.sample

# Local AI-agent config and session state (machine-specific, may contain local paths).
.claude/
.cursor/
.aider*

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Staged SEC bulk datasets (large; re-downloadable via download_ownership_data.py)
data/
logs/

# Generated run output. The two committed memos under results/ are regenerable via
# prove_graph_native_wins.py / activist_convergence.py; everything else is disposable.
results/*.json
!results/secgraph_freshness.json

# Editors / OS
.vscode/
.idea/
.DS_Store
